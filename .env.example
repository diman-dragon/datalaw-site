# Скопируйте в .env и заполните. Сервер читает .env сам, дополнительные пакеты не нужны.
PORT=3000
# Публичный адрес сайта (для sitemap и ссылок)
SITE_URL=http://localhost:3000
# Пароль админки. Если не задан, при первом запуске сгенерируется и покажется в консоли
ADMIN_PASSWORD=
# За nginx/Cloudflare: true, чтобы брать IP из X-Forwarded-For
TRUST_PROXY=false
# Уведомления о заявках в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Для статической версии на GitHub Pages: с какого адреса разрешить отправку форм на этот сервер
ALLOWED_ORIGIN=
